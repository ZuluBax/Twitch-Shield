# Copy to .env.local and fill in. Never commit real values.
# Stage 1 needs none of these. They are used from Stage 2 onward.

# From https://dev.twitch.tv/console (register an application)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Must exactly match the OAuth Redirect URL registered in the Twitch console
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# PostgreSQL connection string (local Docker in development)
DATABASE_URL=postgresql://twitchshield:change-me@localhost:5432/twitchshield

# 32-byte random key, base64, used to encrypt Twitch tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
